    "rankingCriterion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "method",
        "candidateSet",
        "order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/edprId"
        },
        "method": {
          "type": "string"
        },
        "candidateSet": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "question",
        "importance"
