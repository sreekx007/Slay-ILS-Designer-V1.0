          }
        },
        "combinedEffectRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ontologyId"
          }
        },
        "interactionCandidateRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ontologyId"
          }
        },
        "superpositionPolicy": {
          "type": "string"
