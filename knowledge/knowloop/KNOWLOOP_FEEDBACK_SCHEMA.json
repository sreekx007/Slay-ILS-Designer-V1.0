{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4d.local/schemas/knowloop-feedback/0.1",
  "title": "Knowloop Feedback Candidate Schema",
  "description": "Schema for LLM-generated feedback candidates emitted after every design query. Candidates are exploratory until reviewed by a human/domain expert.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "candidate_type",
    "status",
    "created_utc",
    "source_query",
    "pipeline_trace",
    "outcome_summary",
    "llm_self_rating",
    "human_feedback_rating",
    "expert_review_decision",
    "suggested_updates",
    "evidence_trace",
    "promotion_policy"
  ],
  "properties": {
    "schema": {
      "const": "knowloop-feedback/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^kl:candidate:[A-Za-z0-9_\\-:.]+$"
    },
    "candidate_type": {
      "type": "string",
      "enum": [
        "confirmation",
        "improvement",
        "correction",
        "new_knowledge_candidate",
        "future_study_candidate",
        "failure_record"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "generated",
        "human_reviewed",
        "needs_evidence",
        "expert_accepted",
        "expert_rejected",
        "implemented",
        "superseded"
      ]
    },
    "created_utc": {
      "type": "string"
    },
    "source_query": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "query_id",
        "raw_text"
      ],
      "properties": {
        "query_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "problem_title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pipeline_trace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "edpr_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "solution_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outcome_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "design_outcome_status",
        "summary",
        "recommended_candidate",
        "known_limitations"
      ],
      "properties": {
        "design_outcome_status": {
          "type": "string",
          "enum": [
            "successful",
            "partial",
            "failed",
            "not_run"
          ]
        },
        "summary": {
          "type": "string"
        },
        "recommended_candidate": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "llm_self_rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parse_quality",
        "pmap_apf_quality",
        "retrieval_quality",
        "solution_quality",
        "evidence_strength",
        "confidence",
        "rationale"
      ],
      "properties": {
        "parse_quality": {
          "$ref": "#/$defs/rating_1_to_5"
        },
        "pmap_apf_quality": {
          "$ref": "#/$defs/rating_1_to_5"
        },
        "retrieval_quality": {
          "$ref": "#/$defs/rating_1_to_5"
        },
        "solution_quality": {
          "$ref": "#/$defs/rating_1_to_5"
        },
        "evidence_strength": {
          "$ref": "#/$defs/rating_1_to_5"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "human_feedback_rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "scale",
        "comment",
        "reviewer",
        "reviewed_utc"
      ],
      "properties": {
        "rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "scale": {
          "const": "1_to_5"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_utc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "expert_review_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision",
        "target_layer",
        "reviewer",
        "reviewed_utc",
        "implementation_reference"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending_review",
            "accepted",
            "rejected",
            "needs_evidence",
            "implemented",
            "superseded"
          ]
        },
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_layer": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "EDPR",
            "EDES",
            "EDAS",
            "EDIKB",
            "Dataset",
            "StandardLayouts",
            "Tools",
            "Docs",
            "None"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "suggested_updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suggested_update"
      }
    },
    "evidence_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "source_type": {
            "type": "string"
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "promotion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_kb_update_allowed",
        "requires_human_review",
        "requires_evidence_for_behavior_rules",
        "candidate_kb_only_until_accepted"
      ],
      "properties": {
        "official_kb_update_allowed": {
          "const": false
        },
        "requires_human_review": {
          "const": true
        },
        "requires_evidence_for_behavior_rules": {
          "const": true
        },
        "candidate_kb_only_until_accepted": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "rating_1_to_5": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "suggested_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_id",
        "target_layer",
        "update_type",
        "priority",
        "issue",
        "suggested_change",
        "evidence_requirement",
        "status"
      ],
      "properties": {
        "update_id": {
          "type": "string"
        },
        "target_layer": {
          "type": "string",
          "enum": [
            "EDPR",
            "EDES",
            "EDAS",
            "EDIKB",
            "Dataset",
            "StandardLayouts",
            "Tools",
            "Docs",
            "None"
          ]
        },
        "update_type": {
          "type": "string",
          "enum": [
            "confirmation",
            "improvement",
            "correction",
            "new_rule",
            "new_parameter",
            "new_dataset_row",
            "new_example",
            "future_study"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "issue": {
          "type": "string"
        },
        "suggested_change": {
          "type": "string"
        },
        "evidence_requirement": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "needs_evidence",
            "accepted",
            "rejected",
            "implemented",
            "superseded"
          ]
        }
      }
    }
  }
}
