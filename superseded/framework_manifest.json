  "runtime_sequence": [
    {
      "step": 1,
      "name": "read_manifest",
      "action": "Load framework_manifest.json first to discover schemas, knowledge sources, tools, and examples."
    },
    {
      "step": 2,
      "name": "parse_problem_to_edpr",
      "action": "Use knowledge/edpr/EDPR_PARSER_PROMPT_RUNTIME_v0_1.md with user problem text and relevant ontology summaries to emit EDPR JSON."
    },
    {
      "step": 3,
      "name": "validate_edpr",
      "action": "Run tools/EDPR_VALIDATOR_v0_2.py against schemas/EDPR_METASCHEMA_v0_1.json."
    },
    {
      "step": 4,
      "name": "retrieve_component_knowledge",
      "action": "Use candidateComponents from EDPR to load matching knowledge/edes files."
    },
    {
      "step": 5,
      "name": "retrieve_assembly_rules",
      "action": "Use candidateAssemblies to load EDAS shared knowledge and any specific assembly rules."
    },
    {
      "step": 6,
      "name": "retrieve_standard_layouts",
      "action": "Use standardLayoutCandidates to load standard_ils_layouts and matching anchors."
    },
    {
      "step": 7,
      "name": "retrieve_behaviour_graph",
      "action": "Use retrievalPlan targets to query EDIKB_FULL_KNOWLEDGE_GRAPH_v0_3.json for rules, guidance, evidence, and ML candidates."
    },
    {
      "step": 8,
      "name": "retrieve_numeric_evidence",
      "action": "Use numericComparisonPlan filters to query EDIKB_FULL_WITH_EAST_EASB_COMBINED_DEDUPED_v0_1.csv."
    },
    {
      "step": 9,
      "name": "solve_and_explain",
      "action": "Propose concept designs using EDPR objectives, EDAS validity, EDIKB graph rules, and numeric evidence rows; state assumptions and verification needs."
    }
  ],
  "validator_commands": {
    "validate_edpr_examples": "python tools/EDPR_VALIDATOR_v0_2.py --schema schemas/EDPR_METASCHEMA_v0_1.json examples/*.json",
    "current_workspace_equivalent": "python output/edpr/EDPR_VALIDATOR_v0_2.py --schema output/edpr/EDPR_METASCHEMA_v0_1.json output/edpr_batch_tests/*.json"
  },
  "known_gaps_and_next_updates": [
    "Add missing standard layout anchor ILT-L-ST-PS because EDIKB dataset contains L-ST-PS but current standard layout library does not list that anchor.",
    "Clarify EDAS IDs for external_attachment_top_structure, external_attachment_base_structure, and branch_layout if they remain local/unresolved in EDPR examples.",
    "Add or formalize ILS-VLV standard layout if valve support/protection layouts become recurring design cases.",
    "Add a repository-level runner script that performs parse, validate, retrieve, and solve steps in sequence.",
    "Install jsonschema in local runtime or vendor a minimal validation path for full JSON Schema checks."
  ]
